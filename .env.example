# Template variabel environment. SALIN ke .env lalu isi nilainya:
#   cp .env.example .env
# Sumber kebenaran: services/api-gateway/src/config/config.go (Go) + docker-compose.yml.
# JANGAN commit .env — hanya file .example ini yang di-track.
#
# Nilai setelah "=" adalah DEFAULT bila var dikosongkan/tak diset.
# Tanda [brain] = nilai ini di-override otomatis di dalam container oleh
# deploy/brain/docker-compose.brain.yml (karena localhost di container ≠ host).

# ─── API Gateway ────────────────────────────────────────────
GATEWAY_PORT=4000

# ─── WAHA (transport WhatsApp) ──────────────────────────────
WAHA_API_KEY=
WAHA_URL=http://localhost:13000          # [brain] → http://waha:3000
WAHA_SESSION=default                     # WAHA Core mewajibkan "default"
# Login dashboard & Swagger WAHA (dibaca docker-compose.yml, bukan Go)
WAHA_DASHBOARD_USERNAME=
WAHA_DASHBOARD_PASSWORD=

# ─── OpenClaw (dipanggil sbg subprocess CLI oleh gateway) ───
OPENCLAW_BIN=openclaw                    # binary di PATH
OPENCLAW_AGENT=pa_communicator           # agent target default
OPENCLAW_TIMEOUT_SEC=180                 # batas waktu satu turn agent
# OPENCLAW_NODE / OPENCLAW_SCRIPT: hanya untuk mode node+script (dev Windows).
# OPENCLAW_URL: legacy, TIDAK dipakai — OpenClaw diakses via CLI, bukan HTTP.
# [brain] lokasi state OpenClaw yang dipersist (default ./data/openclaw):
# OPENCLAW_STATE_DIR=

# ─── Database (PostgreSQL) ──────────────────────────────────
DB_HOST=localhost                        # [brain] → postgres
DB_PORT=25432                            # [brain] → 5432 (port internal container)
DB_USER=pa_ai
DB_PASS=                                 # WAJIB. Terkunci saat volume DB pertama kali dibuat.
DB_NAME=pa_ai

# ─── Redis ──────────────────────────────────────────────────
REDIS_ADDR=localhost:6379                # [brain] → redis:6379

# ─── Keamanan ───────────────────────────────────────────────
ADMIN_API_KEY=                           # WAJIB. Melindungi /admin/* — ganti dari nilai dev sebelum produksi.
RATE_LIMIT_MAX=20                        # maks pesan per window per kontak
RATE_LIMIT_WINDOW_SEC=60
MAX_MSG_LEN=2000
# Mode whitelist WhatsApp:
#   strict = hanya kontak whitelist yang dilayani; nomor lain DIBLOKIR (default aman).
#   open   = SEMUA penelepon otomatis di-whitelist sbg 'external' & dilayani
#            pa_communicator (SU & Nova tetap dari SU_PHONE/NOVA_PHONE di bawah).
#            Nomor yang diblokir admin (external_contacts.status='blocked') tetap ditolak.
WHITELIST_MODE=strict

# ─── Kontak trusted (di-seed ke whitelist saat start) ───────
# LID = ID privasi WhatsApp; pesan masuk bisa datang sbg @lid, bukan nomor asli.
SU_PHONE=
SU_LID=
NOVA_PHONE=
NOVA_LID=

# ─── Pengingat ──────────────────────────────────────────────
MEETING_REMINDER_LEAD_MIN=15             # menit sebelum meeting untuk pengingat otomatis

# ─── MS Graph (Calendar + Email, in-process sejak Fase 9) ───
# Tak lengkap → penjadwalan meeting (Calendar/Email) NONAKTIF.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_USER_UPN=                       # pengirim email & pemilik calendar
# Refresh token DELEGATED (opsional) — fallback baca email (Email Watch) bila izin
# aplikasi (Mail.Read) belum tersedia.
MS_GRAPH_REFRESH_TOKEN=
FROM_NAME=PA Asisten
SIGNATURE_PATH=assets/signature.html

# ─── Alerting (Fase M3b) ────────────────────────────────────
ALERT_EMAIL_TO=                          # tujuan notifikasi alert kesehatan/keamanan
# Bearer token untuk POST /internal/alerts. KOSONG = endpoint nonaktif.
# Nilai HARUS sama dengan isi monitoring/alertmanager/webhook_token.
ALERT_WEBHOOK_TOKEN=

# ─── Grafana (dibaca docker-compose.yml, bukan Go) ──────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
