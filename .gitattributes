# Normalisasi akhir baris. Repo ini dikembangkan di Windows (core.autocrlf=true)
# tetapi di-deploy ke Linux/Docker.
#
# Skrip shell WAJIB LF: file ber-CRLF yang masuk container gagal dengan
# "bad interpreter: /usr/bin/env bash^M" — error yang menyesatkan.
# Berlaku untuk working copy Windows juga, karena docker build menyalin working copy.
*.sh            text eol=lf
Dockerfile      text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
.env.example    text eol=lf

# PowerShell dijalankan di Windows — biarkan CRLF.
*.ps1           text eol=crlf

# Go: gofmt selalu LF.
*.go            text eol=lf
go.mod          text eol=lf
go.sum          text eol=lf

# Biner — jangan diutak-atik.
*.png           binary
*.gz            binary
*.sqlite        binary
