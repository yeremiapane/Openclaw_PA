# ─── Rahasia ────────────────────────────────────────────────
# .env berisi kredensial asli — JANGAN pernah di-commit.
# .env.example (template, semua nilai kosong) SENGAJA di-track sbg dokumentasi
# var yang dibutuhkan — lihat services/api-gateway/src/config/config.go.
.env
.env.*
!.env.example

# Alertmanager webhook Bearer token (isi = ALERT_WEBHOOK_TOKEN)
/monitoring/alertmanager/webhook_token

# Kredensial O365/Google
/credentials/

# ─── Data & state runtime (jangan di-commit) ────────────────
# /data/  = volume container: data/postgres (DB) & data/openclaw (state brain).
# /.waha/ = session WhatsApp.
# /.openclaw/ = state OpenClaw lokal / hasil ekstrak dump migrasi. Memuat RAHASIA
#   (openclaw.json → gateway.auth.token) — diabaikan SELURUHNYA, bukan cache/log saja.
/data/
/.waha/
/.waha.noweb.bak
/.openclaw/
openclaw-dump.tar.gz

# QR code WAHA = artefak login, jangan di-commit
waha_qr.png

# ─── Go ─────────────────────────────────────────────────────
# CATATAN: go.mod & go.sum WAJIB ter-track — deploy/brain/Dockerfile menyalinnya
# saat build. Jangan pernah menambahkannya ke daftar ini.
*.exe
*.test
*.out
/bin/

# ─── Node ───────────────────────────────────────────────────
node_modules/
npm-debug.log*

# ─── OS / editor ────────────────────────────────────────────
Thumbs.db
.DS_Store

# ─── Log ────────────────────────────────────────────────────
log.txt
